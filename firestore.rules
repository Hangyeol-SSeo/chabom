rules_version = '2';

// 차봄 Firestore 보안 규칙.
// - 사용자 데이터는 users/{uid}/history, users/{uid}/dealers 아래에만 있고 본인만 읽고 쓴다.
// - 허용 목록(allowlist/{소문자 이메일})에 있는 Google(이메일 인증)·카카오(oidc.kakao) 계정만 쓸 수 있다.
//   같은 규칙이 API 서버의 api/auth.py에도 있다 — 한쪽을 바꾸면 다른 쪽도 바꾼다.
// - allowlist와 usage(일일 조회 한도)는 관리 스크립트와 API 서버(관리자 권한)만 쓴다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth != null && request.auth.token.email is string && request.auth.token.email.size() > 0;
    }
    function trustedProvider() {
      let provider = request.auth.token.firebase.sign_in_provider;
      return (provider == 'google.com' && request.auth.token.email_verified == true)
        || provider == 'oidc.kakao';
    }
    function allowed() {
      return signedInEmail() && trustedProvider()
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }
    function owner(uid) {
      return allowed() && request.auth.uid == uid;
    }
    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    function validHistory(data) {
      return data.keys().hasAll(['url', 'source', 'listing', 'last_viewed_at', 'status', 'reason', 'favorite', 'origin'])
        && data.keys().hasOnly(['url', 'source', 'listing', 'last_viewed_at', 'status', 'reason', 'favorite', 'origin'])
        && shortString(data.url, 2048) && data.url.matches('^https?://.+')
        && shortString(data.source, 40)
        && (data.listing == null || data.listing is map)
        && shortString(data.last_viewed_at, 64)
        && data.status in ['success', 'failed']
        && shortString(data.reason, 2000)
        && data.favorite is bool
        && data.origin in ['lookup', 'snapshot'];
    }

    function validDealer(data) {
      return data.keys().hasAll(['source', 'dealer_key', 'display_name', 'phone', 'region', 'blacklisted', 'favorite',
                                 'reason', 'blacklisted_at', 'created_at', 'updated_at'])
        && data.keys().hasOnly(['source', 'dealer_key', 'display_name', 'phone', 'region', 'blacklisted', 'favorite',
                                'reason', 'blacklisted_at', 'created_at', 'updated_at'])
        && shortString(data.source, 40) && data.source.size() > 0
        && shortString(data.dealer_key, 200) && data.dealer_key.size() > 0
        && shortString(data.display_name, 200)
        && shortString(data.phone, 40) && data.phone.matches('^[0-9]*$')
        && shortString(data.region, 200)
        && data.blacklisted is bool && data.favorite is bool
        // 블랙리스트에 올린 딜러는 찜할 수 없다. 블랙리스트에 올릴 때는 찜을 함께 해제한다.
        && !(data.blacklisted && data.favorite)
        && shortString(data.reason, 1000)
        && (!data.blacklisted || data.reason.size() > 0)
        && shortString(data.blacklisted_at, 64)
        && shortString(data.created_at, 64) && shortString(data.updated_at, 64);
    }

    match /allowlist/{email} {
      // 본인 문서만 읽을 수 있다 — 화면이 "승인 대기" 여부를 판단할 때 쓴다.
      allow get: if signedInEmail() && email == request.auth.token.email.lower();
      allow list, write: if false;
    }

    match /usage/{document=**} {
      allow read, write: if false;
    }

    match /users/{uid}/history/{itemId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validHistory(request.resource.data);
    }

    match /users/{uid}/dealers/{dealerId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validDealer(request.resource.data);
    }
  }
}
